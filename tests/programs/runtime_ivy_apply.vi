
use #root::Ivy;

pub fn main(&io: &IO) {
  test_value_output(&io);
  test_load_failure_returns_input(&io);
}

fn test_value_output(&io: &IO) {
  let identity = "iv:main \{\n  ^ = ivm:x(value value)\n}";

  let input: N32 = 42;

  let result: Result[N32, (Ivy::LoadError, N32)] = Ivy::apply[N32, N32](identity, input);

  match result {
    Ok(value) { io.println("value {value}"); }
    Err((_error, _input)) { io.println("unexpected value error"); }
  }
}

fn test_load_failure_returns_input(&io: &IO) {
  let missing_main = "iv:not_main \{\n  ^ = ivm:x(value value)\n}";

  let input: N32 = 7;

  let result: Result[N32, (Ivy::LoadError, N32)] = Ivy::apply[N32, N32](missing_main, input);

  match result {
    Ok(value) { io.println("unexpected success {value}"); }
    Err((_error, recovered_input)) { io.println("recovered {recovered_input}"); }
  }
}
