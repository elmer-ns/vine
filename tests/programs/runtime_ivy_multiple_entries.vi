
use #root::Ivy;

pub fn main(&io: &IO) {
  let source =
    "iv:first \{\n  ^ = ivm:x(value value)\n}\n
     iv:second \{\n  ^ = ivm:x(value value)\n}"
  ;

  let module = Ivy::Module::compile(source);

  match module {
    Ok(module) {
      let a = module.run[N32, N32]("iv:first", 10);
      let b = module.run[N32, N32]("iv:second", 20);
      let c = module.run[N32, N32]("iv:first", 30);
      let missing = module.run[N32, N32]("iv:missing", 30);

      match a {
        Ok(a) { io.println("{a}") }
        Err(error) { io.println(error.0) }
      }

      match b {
        Ok(b) { io.println("{b}") }
        Err(error) { io.println(error.0) }
      }

      match c {
        Ok(c) { io.println("{c}") }
        Err(error) { io.println(error.0) }
      }

      match missing {
        Ok(_) { io.println("unexpected") }
        Err(_) {}
      }
    }
    Err(error) { io.println(error) }
  }
}
