
use #root::Ivy;

pub fn main(&io: &IO) {
  let source =
    "iv:first \{\n  ^ = ivm:x(value value)\n}\n
     iv:second \{\n  ^ = ivm:x(value value)\n}"
  ;

  match Ivy::Module::compile(source) {
    Ok(_module) { io.println("compiled"); }
    Err(error) { io.println("compile error: {error}"); }
  }
}
